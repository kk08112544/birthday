
generator client {
  provider        = "prisma-client-js"
  output          = "../node_modules/.prisma/client"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlserver"
}

model Sender {
  sId        Int      @id @default(autoincrement())
  position   String
  department String
  cardId     Int
  wishId     Int
  festivalId Int
   
  fullname   String
  createdAt  DateTime @default(now(), map: "DF__Sender__createdA__6EF57B66")

  card       Card     @relation(fields: [cardId], references: [cId], onUpdate: NoAction)
  wish       Wisher     @relation(fields: [wishId], references: [wId], onUpdate: NoAction)
  festival   Festival @relation(fields: [festivalId], references: [fId], onUpdate: NoAction)
}

model Wisher {
  wId        Int       @id @default(autoincrement())
  wishWord   String
  festivalId Int
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  updatedAt  DateTime  @updatedAt
  festival   Festival  @relation(fields: [festivalId], references: [fId])
  sender     Sender[]
}

model Card {
  cId        Int       @id @default(autoincrement())
  imageCard  String
  festivalId Int
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  festival   Festival  @relation(fields: [festivalId], references: [fId])
  sender     Sender[]
}

model Festival {
  fId          Int       @id @default(autoincrement())
  festivalName String
  image        String
  logo         String?
  webName      String?
  startDate    DateTime
  endDate      DateTime
  isEdit       Boolean @default(true)
  isDelete     Boolean @default(true)
  isEditEndDate Boolean @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?
  card         Card[]
  wisher       Wisher[]
  Sender       Sender[]
}

model Unpolite {
  upId      Int       @id @default(autoincrement())
  word      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model User {
  uId       Int    @id @default(autoincrement())
  firstName String
  userName  String @unique
  password  String
}
